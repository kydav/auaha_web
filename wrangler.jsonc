{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auaha",
	"main": "src/index.js",
	"compatibility_date": "2026-06-01",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "TILES",
			"bucket_name": "co-parcels"
		}
	],
	"d1_databases": [
		{
			// MUST be EVENTS — src/index.js guards on `env.EVENTS`, and the guard
			// fails open (silent 204) so a mismatched name loses every event
			// without an error anywhere. It was bound as `auaha_events` from
			// 2026-09-05 until this was fixed; that window recorded nothing.
			"binding": "EVENTS",
			"database_name": "auaha-events",
			"database_id": "6b9bfbbc-ac6b-4821-8920-7c8d6eaeb394"
		}
	]
}